# Seu nome como aparece no Teams (o report destaca o que for para você)
OWNER_NAME=

# ---- App Registration (Entra ID), permissões delegadas, sem client secret ----
GRAPH_CLIENT_ID=
GRAPH_TENANT_ID=

# ---- LLM ----
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_FAST_MODEL=claude-haiku-5-5

# ---- Comportamento ----
TZ_NAME=America/Sao_Paulo
# Segundos entre leituras de comandos no chat de notas do Teams
COMMAND_POLL_SECONDS=20
# true = lembretes e alertas de prioridade também por e-mail (pede Mail.Send)
NOTIFY_EMAIL=false
# Segundos entre sincronizações dos chats acompanhados
POLL_INTERVAL_SECONDS=300
BACKFILL_DAYS=7
# HH:MM para report diário dos chats acompanhados; vazio desativa
DAILY_REPORT_TIME=18:00
# Alerta na hora para mensagens de pessoas com prioridade <= N (1 = só alta, 2 = alta e normal). Vazio desativa.
ALERT_PRIORITY=1
# Aprendizado automático de memórias por pessoa: auto | review | off (muda também por /aprender)
LEARN_MODE=auto
# Só chama o LLM depois de juntar N mensagens novas do chat (ou 24h), para economizar tokens
LEARN_MIN_MESSAGES=10
LEARN_MAX_CALLS=6

# ---- Infra ----
# Use só letras e números (vai dentro da URL de conexão)
POSTGRES_PASSWORD=
